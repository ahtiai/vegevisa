# Separate database for each environment. Never point local tests at production.
DATABASE_URL=postgresql://localhost:5432/vegevisa
DATABASE_ENV=preview

# Run npm run admin:password, then securely copy values from .env.admin.local.
ADMIN_PASSWORD_HASH=
ADMIN_RATE_LIMIT_SECRET=

# Exact public origin. On Vercel previews, omit to use that deployment's VERCEL_URL.
APP_ORIGIN=http://localhost:3000
